# Where the browser sends assistant messages. Leave unset in development:
# vite proxies /api/chat to the worker running on 127.0.0.1:8787.
# In production set this to the deployed worker URL, e.g.
# VITE_AI_ENDPOINT=https://naano-ai.ammtech.workers.devhttps://naano-ai.<your-subdomain>.workers.dev
VITE_AI_ENDPOINT=https://naano-ai.ammtech.workers.dev
