# Neon pooled connection, used by the app at runtime
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Neon direct connection, used only by prisma migrate
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,https://muhammadhassan6603.github.io
PORT=4000
# Optional. Base URL for tracking links; defaults to the host of each request.
PUBLIC_API_URL=http://localhost:4000
# Optional. How long a brand has to object before a submitted post is auto-approved.
AUTO_APPROVE_HOURS=72
# Only on the Neon test branch: lets `npm test` run (its cleanup deletes ledger rows).
# TEST_DATABASE=1
