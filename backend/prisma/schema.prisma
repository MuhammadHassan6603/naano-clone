generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  brand
  creator
}

enum BookingStatus {
  requested
  accepted
  submitted
  paid
  refunded
}

enum VerifiedVia {
  brand
  click
  timeout
}

enum RefundReason {
  declined
  expired
}

enum TransactionType {
  topup
  hold
  release
  payout
  refund
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile         CreatorProfile?
  brandProfile    BrandProfile?
  wallet          Wallet?
  transactions    Transaction[]
  brandBookings   Booking[]       @relation("BrandBookings")
  creatorBookings Booking[]       @relation("CreatorBookings")
  messages        Message[]
  messageReads    MessageRead[]

  @@map("users")
}

model CreatorProfile {
  userId     String   @id @map("user_id") @db.Uuid
  niche      String?
  bio        String   @default("")
  audience   String   @default("")
  priceCents Int?     @map("price_cents")
  followers  Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model BrandProfile {
  userId      String   @id @map("user_id") @db.Uuid
  niches      String[] @default([])
  audience    String   @default("")
  budgetCents Int?     @map("budget_cents")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

model Wallet {
  userId         String @id @map("user_id") @db.Uuid
  availableCents Int    @default(0) @map("available_cents")
  heldCents      Int    @default(0) @map("held_cents")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  bookingId   String?         @map("booking_id") @db.Uuid
  type        TransactionType
  amountCents Int             @map("amount_cents")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId, createdAt])
  @@index([bookingId])
  @@map("transactions")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  brandId        String        @map("brand_id") @db.Uuid
  creatorId      String        @map("creator_id") @db.Uuid
  brief          String
  destinationUrl String        @map("destination_url")
  priceCents     Int           @map("price_cents")
  status         BookingStatus @default(requested)
  deadline       DateTime      @db.Timestamptz(3)
  postUrl        String?       @map("post_url")
  trackingCode   String        @unique @map("tracking_code")
  verifiedVia    VerifiedVia?  @map("verified_via")
  refundReason   RefundReason? @map("refund_reason")
  submitIpHash   String?       @map("submit_ip_hash")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  acceptedAt     DateTime?     @map("accepted_at") @db.Timestamptz(3)
  submittedAt    DateTime?     @map("submitted_at") @db.Timestamptz(3)
  closedAt       DateTime?     @map("closed_at") @db.Timestamptz(3)

  brand        User          @relation("BrandBookings", fields: [brandId], references: [id])
  creator      User          @relation("CreatorBookings", fields: [creatorId], references: [id])
  transactions Transaction[]
  clicks       Click[]
  messages     Message[]
  reads        MessageRead[]

  @@index([status, deadline])
  @@index([status, submittedAt])
  @@index([brandId])
  @@index([creatorId])
  @@map("bookings")
}

model Click {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  clickedAt DateTime @default(now()) @map("clicked_at") @db.Timestamptz(3)
  ipHash    String   @map("ip_hash")
  userAgent String   @map("user_agent")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, clickedAt])
  @@map("clicks")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id])
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([bookingId, createdAt])
  @@map("messages")
}

model MessageRead {
  bookingId String   @map("booking_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @map("read_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([bookingId, userId])
  @@map("message_reads")
}
